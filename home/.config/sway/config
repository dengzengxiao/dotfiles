#
# Window rules
#
# Remove Sway-managed borders and title bars
default_border none
default_floating_border none
default_orientation auto

# Apply the borderless layout to every newly mapped Wayland and XWayland window.
for_window [app_id=".*"] border none
for_window [class=".*"] border none

include @sysconfdir@/sway/config.d/*

# Sway session services migrated from the niri startup configuration
# Export the active Wayland session to D-Bus and systemd user services
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec sh -c 'XDG_CURRENT_DESKTOP=sway systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP'

# Start the input method daemon for native Wayland and XWayland applications
exec fcitx5 -d

# Mount removable devices and show their tray indicator
exec udiskie -t

# Start the Yazi-backed terminal file chooser selected in portals.conf
exec /usr/lib/xdg-desktop-portal-termfilechooser -r

# Startups
exec --no-startup-id waybar
exec --no-startup-id mako
exec --no-startup-id ~/.cargo/bin/swtchrd
exec --no-startup-id wl-clip-persist --clipboard regular
exec --no-startup-id wl-paste --type text --watch cliphist store
exec --no-startup-id wl-paste --type image --watch cliphist store

